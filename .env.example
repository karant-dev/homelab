# Core
DOMAIN=example.com
TZ=Etc/UTC
PUID=1000
PGID=1000

# Paths
DATA_ROOT=/opt/homelab/data
MEDIA_ROOT=/srv/media
CONFIG_ROOT=./configs

# Config templating
HOMER_TITLE="My Homelab"
HOMER_ORIGIN=https://homelab.example.com

# Required secrets
CLOUDFLARE_API_TOKEN=replace_me
CLOUDFLARE_TUNNEL_TOKEN=replace_me
TAILSCALE_AUTH_KEY=replace_me

# Optional service secrets
CODE_SERVER_PASSWORD=replace_me
CODE_SERVER_SUDO_PASSWORD=replace_me
GLUETUN_WIREGUARD_PRIVATE_KEY=replace_me
GLUETUN_OPENVPN_USER=
GLUETUN_OPENVPN_PASSWORD=
PLEX_CLAIM=
JELLYPLEX_PLEX_TOKEN=
JELLYPLEX_JELLYFIN_TOKEN=
KARAKEEP_NEXTAUTH_SECRET=replace_me
KARAKEEP_MEILI_MASTER_KEY=replace_me
N8N_TELEGRAM_CHAT_ID=
HOMER_API_KEY_PLACEHOLDER=replace_me
MUSICGRABBER_ACOUSTID_API_KEY=
