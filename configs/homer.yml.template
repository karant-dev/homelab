---
title: "${HOMER_TITLE}"
subtitle: "Bosgame Mini PC (R7 6800H + 32 GB DDR5) | Tailscale Network"
logo: "https://cdn.jsdelivr.net/gh/walkxcode/dashboard-icons/png/homer.png"
favicon: "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/homebox.png"
theme: walkxcode
header: false
footer: false

columns: "3"
connectivityCheck: true

proxy:
  useCredentials: false

links:
  - name: "Poolsuite"
    icon: "fas fa-umbrella-beach"
    url: "https://poolsuite.net/"
    target: "_blank"
  - name: "Cloudflare"
    icon: "fas fa-cloud"
    url: "https://dash.cloudflare.com/488fdd875f76300295df136c8b5466db/${DOMAIN}/dns/records"
    target: "_blank"
  - name: "Tailscale Admin"
    icon: "fas fa-network-wired"
    url: "https://login.tailscale.com/admin"
    target: "_blank"
  - name: "Icons"
    icon: "fas fa-icons"
    url: "https://dashboardicons.com/"
    target: "_blank"
  - name: "Configs"
    icon: "fas fa-code"
    url: "https://code.${DOMAIN}"
    target: "_blank"

services:
  - name: "System 📊"
    icon: "fas fa-heartbeat"
    items:
      - name: "System Stats"
        logo: "https://cdn.jsdelivr.net/gh/walkxcode/dashboard-icons/png/synology-vmm.png"
        subtitle: "CPU, RAM, Disk, Network"
        url: "https://stats.${DOMAIN}"
        target: "_blank"
        type: "Glances"
        endpoint: "https://stats.${DOMAIN}"
        stats: [cpu, mem]
        # Click → goes to stats.${DOMAIN}
        # Stats → fetched from localhost:61208
      
      - name: "AdGuard Home"
        type: "AdGuardHome"
        logo: "https://cdn.jsdelivr.net/gh/walkxcode/dashboard-icons/png/adguard-home.png"
        subtitle: "Network DNS & Ad-blocking"
        tag: "network"
        keywords: "dns adblock security"
        url: "https://adguard.${DOMAIN}"
        target: "_blank"
        headers:
          Authorization: "${HOMER_ADGUARD_AUTH_HEADER}"

      - name: "Portainer"
        logo: "https://cdn.jsdelivr.net/gh/selfhst/icons/png/portainer-pink.png"
        subtitle: "Docker Containers"
        url: "https://portainer.${DOMAIN}"
        target: "_blank"
        type: "Portainer"
        endpoint: "https://portainer.${DOMAIN}"
        apikey: "${HOMER_API_KEY_PLACEHOLDER}"
        # Click → goes to portainer.${DOMAIN}
        # Stats → fetched from portainer.${DOMAIN} API

      - name: "Homebridge"
        logo: "https://cdn.jsdelivr.net/gh/walkxcode/dashboard-icons/png/homebridge.png"
        subtitle: "HomeKit Bridge"
        url: "https://hb.${DOMAIN}"
        target: "_blank"
