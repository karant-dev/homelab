# Public read access for Apache Superset
http://public-viz.${DOMAIN} {
    # The Bouncer: Immediately reject anything sensitive
    @blocked {
        path /login*
        path /admin*
        path /users*
        path /roles*
        path /superset/sql_lab*
        path /api/v1/security*
    }
    respond @blocked "Access Denied - Public Portal" 403

    reverse_proxy localhost:8083 {
        header_up Host {host}
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Port 443
        header_up X-Forwarded-Proto https
    }
}

