{
	email example.com@gmail.com
}

# ───────────────────────── Snippets ─────────────────────────

# Generic Cloudflare DNS TLS
(cloudflare_dns) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}

# Common CORS (param: allowed origin)
(cors) {
	@cors_preflight method OPTIONS
	@cors header Origin {args.0}

	handle @cors_preflight {
		header Access-Control-Allow-Origin "{args.0}"
		header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-Requested-With"
		header Access-Control-Allow-Credentials "true"
		header Access-Control-Max-Age "3600"
		respond "" 204
	}

	handle @cors {
		header Access-Control-Allow-Origin "{args.0}"
		header Access-Control-Allow-Credentials "true"
		header Access-Control-Expose-Headers "Link"
	}
}

# Simple HTTPS reverse proxy with Host passthrough
(site) {
	reverse_proxy {args.0} {
		header_up Host {host}
	}
	import cloudflare_dns
}

# Simple Homer-frontend site (CORS + reverse proxy)
(homer_site) {
	import cors https://homelab.example.com
	import site {args.0}
}

# Strip upstream CORS (inside reverse_proxy)
(strip_down_cors) {
	header_down -Access-Control-Allow-Origin
	header_down -Vary
}

(strip_down_cors_full) {
	header_down -Access-Control-Allow-Origin
	header_down -Access-Control-Allow-Credentials
	header_down -Vary
}

# Homer CORS applied to all paths
(homer_headers_all) {
	@all path *
	header @all {
		Access-Control-Allow-Origin https://homelab.example.com
		Access-Control-Allow-Credentials true
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-Api-Key, X-Requested-With"
		Access-Control-Expose-Headers "*"
		Vary Origin
	}
}

# Homer CORS with extra Transmission header
(homer_headers_all_transmission) {
	@all path *
	header @all {
		Access-Control-Allow-Origin https://homelab.example.com
		Access-Control-Allow-Credentials true
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-Api-Key, X-Requested-With, X-Transmission-Session-Id"
		Access-Control-Expose-Headers "X-Transmission-Session-Id"
		Vary Origin
	}
}

# Homer CORS scoped to /api/*
(homer_headers_api) {
	@api path /api/*
	header @api {
		Access-Control-Allow-Origin https://homelab.example.com
		Access-Control-Allow-Credentials true
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-Api-Key, X-Requested-With"
		Access-Control-Expose-Headers "*"
		Vary Origin
	}
}

# Homer CORS /api/* + extension origin
(homer_headers_api_ext) {
	@api path /api/*
	header @api {
		# Access-Control-Allow-Origin https://homelab.example.com
		Access-Control-Allow-Origin chrome-extension://kgcjekpmcjjogibpjebkhaanilehneje
		Access-Control-Allow-Credentials true
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-Api-Key, X-Requested-With"
		Access-Control-Expose-Headers "*"
		Vary Origin
	}
}

# Reverse proxy with Host passthrough + ability to strip upstream CORS
(site_strip_cors) {
	reverse_proxy {args.0} {
		header_up Host {host}
		import strip_down_cors_full
	}
	import cloudflare_dns
}

