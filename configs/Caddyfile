# qBitTorrent
qbit.karant.dev {
	reverse_proxy localhost:8086 {
		header_up Origin ""
		header_up Referer ""
		header_up Host localhost:8086
		import strip_down_cors_full
	}

	@origin header Origin https://homelab.karant.dev
	header @origin {
		Access-Control-Allow-Origin https://homelab.karant.dev
		Access-Control-Allow-Credentials true
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Allow-Headers "*"
	}

	import cloudflare_dns
}

