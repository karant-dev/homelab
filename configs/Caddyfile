# Copyparty
files.karant.dev {

    # Homer liveness endpoint (CORS-safe)
    @health path /_homer/health
    handle @health {
        header Access-Control-Allow-Origin https://homelab.karant.dev
        header Access-Control-Allow-Credentials true
        respond "ok" 200
    }

    reverse_proxy http://localhost:8090 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-For {remote_host}
        import strip_down_cors
    }

    import cloudflare_dns
}

